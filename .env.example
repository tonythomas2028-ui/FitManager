# Copy to .env and replace every placeholder before running Docker Compose.
APP_ENV=production
APP_VERSION=1.0.0
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=replace-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=fitmanager
POSTGRES_USER=fitmanager_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Compose overrides DATABASE_URL using the internal PostgreSQL service name.
